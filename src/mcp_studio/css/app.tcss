/* MCP Studio — dark Postman-like terminal theme */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

Header {
    background: #161b22;
    color: #58a6ff;
    text-style: bold;
}

Footer {
    background: #161b22;
    color: #8b949e;
}

#top-bar {
    height: 3;
    dock: top;
    background: #161b22;
    padding: 0 1;
    align: left middle;
}

#brand {
    width: 14;
    color: #58a6ff;
    text-style: bold;
    content-align: left middle;
}

#cmd-input {
    width: 1fr;
    background: #0d1117;
    border: tall #30363d;
    margin: 0 1;
}

#cmd-input:focus {
    border: tall #58a6ff;
}

#status {
    width: 30;
    color: #8b949e;
    content-align: right middle;
    padding: 0 1;
}

#status.connected {
    color: #3fb950;
}

#status.error {
    color: #f85149;
}

#status.busy {
    color: #d29922;
}

#main {
    height: 1fr;
}

#left {
    width: 28%;
    border: solid #30363d;
    background: #0d1117;
    margin: 0 0 0 0;
}

#center {
    width: 36%;
    border: solid #30363d;
    background: #0d1117;
}

#right {
    width: 36%;
    border: solid #30363d;
    background: #0d1117;
}

.panel-title {
    background: #21262d;
    color: #e6edf3;
    text-style: bold;
    padding: 0 1;
    height: 1;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0;
}

ListView {
    height: 1fr;
    background: #0d1117;
}

ListView > ListItem {
    padding: 0 1;
}

ListView > ListItem.--highlight {
    background: #1f6feb;
    color: #ffffff;
}

#schema {
    height: 1fr;
    min-height: 6;
    border: tall #30363d;
    background: #010409;
    color: #a5d6ff;
}

#args {
    height: 12;
    border: tall #30363d;
    background: #010409;
    color: #e6edf3;
}

#args:focus, #schema:focus, #response:focus {
    border: tall #58a6ff;
}

#response {
    height: 1fr;
    border: tall #30363d;
    background: #010409;
    color: #c9d1d9;
}

#run-row {
    height: 3;
    align: left middle;
    padding: 0 1;
    background: #161b22;
}

#latency {
    color: #8b949e;
    padding: 0 0 0 2;
}

#latency.ok {
    color: #3fb950;
}

#latency.err {
    color: #f85149;
}

Button {
    margin: 0 1 0 0;
}

#history-panel {
    width: 84%;
    height: 72%;
    border: heavy #58a6ff;
    background: #0d1117;
    padding: 1;
}

#history-title {
    color: #58a6ff;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#history-list {
    height: 1fr;
    border: tall #30363d;
    margin-bottom: 1;
}
